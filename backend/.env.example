# ========== Redis（可选，不填则使用本地内存存储） ==========
# REDIS_URL=redis://default:password@host:port

# ========== 服务器 ==========
PORT=3000
NODE_ENV=production

# ========== AI 模型服务（OpenAI-compatible 通义千问 / 讯飞 MaaS） ==========
AI_API_KEY=your_api_key_here
AI_BASE_URL=https://maas-api.cn-huabei-1.xf-yun.com
AI_MODEL=xopqwen36v35b

# ========== LLM-as-judge 评测专用（独立 Key，不跟生产抢配额） ==========
# JUDGE_API_KEY=your_judge_api_key_here
# JUDGE_MODEL=step-3.5-flash

# ========== 讯飞（可选） ==========
XUNFEI_API_KEY=your_xunfei_api_key_here
XUNFEI_APP_ID=your_xunfei_app_id_here

# ========== 本地 Embedding（BGE-small-zh） ==========
EMBEDDING_MODEL=Xenova/bge-small-zh-v1.5
EMBEDDING_CACHE_DIR=../.model-cache
EMBEDDING_LOCAL_FILES_ONLY=true
EMBEDDING_SPARSE_DIM=250002

# ========== Milvus Lite / Milvus 混合向量库 ==========
VECTOR_STORE_BACKEND=milvus
MILVUS_ADDRESS=localhost:19530
MILVUS_COLLECTION=wuli_elf_chunks
MILVUS_DENSE_FIELD=dense_vector
MILVUS_SPARSE_FIELD=sparse_vector
MILVUS_DENSE_WEIGHT=0.6
MILVUS_SPARSE_WEIGHT=0.4

# ========== RAG 检索 ==========
RAG_HYBRID_SEARCH=true
RAG_VECTOR_TOP_K=50
RAG_RERANK_TOP_K=10
RAG_VECTOR_WEIGHT=0.6
RAG_SPARSE_WEIGHT=0.4
RAG_MIN_SOURCE_SCORE=0.03

# ========== JWT（必须设置，用于用户认证） ==========
JWT_SECRET=<SECRET_7c7b61a7>andom_string_here

# ========== 学校教务系统 ==========
SCHOOL_TP_HOST=https://one.whut.edu.cn
SCHOOL_JW_HOST=https://jwxt.whut.edu.cn
SCHOOL_ENC_KEY=<SECRET_6d9681c0>m_key_here

# ========== 自有账号注册（可选，不填则不校验邀请码） ==========
AUTH_INVITE_CODE=change_me_invite_code

# ========== 管理员登录（不依赖教务系统） ==========
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_admin_password_here



