# ======================================================================
# 武理小精灵 — 生产环境变量模板
# 部署前复制为 .env.production 并填入真实值
# ======================================================================

# ---------- 服务器 ----------
PORT=3000
NODE_ENV=production

# ---------- AI 模型服务（阶跃星辰 StepFun / OpenAI 兼容 API） ----------
AI_API_KEY=your_ai_api_key_here
AI_BASE_URL=https://api.stepfun.com/v1
AI_MODEL=step-3.7-flash
# LLM 并发数：控制同时发往 API 的请求数，避免触发速率限制（429）
LLM_CONCURRENCY=3

# ---------- StepFun 语音合成（可选） ----------
# 主模型不是 StepFun 时必须单独设置 STEPFUN_API_KEY
# STEPFUN_API_KEY=your_stepfun_api_key_here
STEPFUN_AUDIO_BASE_URL=https://api.stepfun.com/v1
STEPFUN_TTS_MODEL=stepaudio-2.5-tts
STEPFUN_TTS_VOICE=cixingnansheng
STEPFUN_TTS_FORMAT=mp3
STEPFUN_TTS_SPEED=1
STEPFUN_TTS_INSTRUCTION=自然、亲切、清晰，像校园里的学长学姐耐心回答问题
STEPFUN_TTS_MAX_AUDIO_BYTES=16777216
STEPFUN_TTS_CACHE_ENABLED=true
STEPFUN_TTS_CACHE_TTL_MS=1800000
STEPFUN_TTS_CACHE_MAX_ENTRIES=100
STEPFUN_TTS_CACHE_MAX_BYTES=67108864

# ---------- 运营监控持久化 ----------
OPS_TIMEZONE=Asia/Shanghai
OPS_METRICS_PERSISTENCE=true
OPS_METRICS_PERSIST_INTERVAL_MS=5000

# ---------- LLM-as-judge 评测专用（独立 Key，不跟生产抢配额） ----------
# 不设置则默认使用 AI_API_KEY
# JUDGE_API_KEY=your_judge_api_key_here
# JUDGE_MODEL=step-3.5-flash

# ---------- 本地 Embedding（BGE-small-zh） ----------
EMBEDDING_MODEL=Xenova/bge-small-zh-v1.5
EMBEDDING_CACHE_DIR=/app/.model-cache
EMBEDDING_LOCAL_FILES_ONLY=true
EMBEDDING_SPARSE_DIM=250002

# ---------- 向量库与 RAG 检索 ----------
MILVUS_ADDRESS=milvus:19530
MILVUS_COLLECTION=wuli_elf_chunks
MILVUS_DENSE_FIELD=dense_vector
MILVUS_SPARSE_FIELD=sparse_vector
MILVUS_DENSE_WEIGHT=0.6
MILVUS_SPARSE_WEIGHT=0.4
RAG_VECTOR_TOP_K=50
RAG_RERANK_TOP_K=10
RAG_MAX_CONTEXT_LENGTH=6000
RAG_MIN_SOURCE_SCORE=0.03

# ---------- Agentic RAG（默认关闭，先灰度验证） ----------
AGENTIC_RAG_ENABLED=false
AGENTIC_RAG_MAX_ROUNDS=2
AGENTIC_RAG_MAX_DURATION_MS=20000
AGENTIC_RAG_REWRITE_TIMEOUT_MS=8000
AGENTIC_RAG_MIN_SOURCES=1

# ---------- 数据库（PostgreSQL） ----------
# 设置此项后启用 PostgreSQL（替代 SQLite，解决原生模块编译问题）
# 格式：postgres://用户名:密码@主机:5432/数据库名
# docker-compose 中 postgres 服务会自动拼好这个值，也可手动覆盖
# DATABASE_URL=postgres://wuli:wuli123456@postgres:5432/wuli_elf

# ---------- JWT 密钥（生产环境务必改为随机 64 位字符串） ----------
JWT_SECRET=your-random-64-char-secret-here-change-in-production

# ---------- CORS（生产环境必填，填写前端域名白名单） ----------
# 多个域名用英文逗号分隔，例如：https://a.example.com,https://b.example.com
CORS_ORIGIN=https://your-domain.com

# ---------- CDN 加速（可选） ----------
# 设置后前端静态资源（JS/CSS/图片）的引用地址会改为 CDN 域名
# 需要先配置 CDN 回源到后端服务，然后设置此地址
# 例如：VITE_CDN_URL=https://static.your-domain.com
# 不设置则使用默认路径 /
